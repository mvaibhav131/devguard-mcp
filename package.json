    "test:stdio": "npm run build && vitest run --config vitest.stdio.config.ts",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
